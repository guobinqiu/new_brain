# ===== 构建镜像源（rag 镜像 build args）=====
USE_CN_MIRROR=true
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
UV_DEFAULT_INDEX_CN=https://pypi.tuna.tsinghua.edu.cn/simple

# ===== rag 运行 =====
# CPU 节点：CONFIG_FILE=rag/config/qdrant-bgebase.yaml
# GPU/ECU 节点：CONFIG_FILE=rag/config/qdrant-bgem3-rerank.yaml
TZ=Asia/Shanghai
CONFIG_FILE=rag/config/qdrant-bgebase.yaml
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-search
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# rag 节点连接当前 compose 内服务。
DATABASE_URL=postgresql://rag:rag@postgres:5432/rag
QDRANT_URL=http://qdrant:6333
MILVUS_URI=http://milvus:19530
OPENSEARCH_URL=http://opensearch:9200
discovery.type=single-node
DISABLE_SECURITY_PLUGIN=true
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag

# ===== llm 运行 =====
OPENAI_API_KEY=dummy
OPENAI_BASE_URL=http://19.16.1.233:8000/v1
MODEL_NAME=vllm
LLM_LANGSMITH_PROJECT=rag-llm
RAG_BASE_URL=http://rag:6000
LANGCHAIN_API_KEY=
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_PROJECT=rag-llm

# ===== 内置基础服务 =====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
CHOKIDAR_USEPOLLING=true
ETCD_AUTO_COMPACTION_MODE=revision
ETCD_AUTO_COMPACTION_RETENTION=1000
ETCD_QUOTA_BACKEND_BYTES=4294967296
ETCD_SNAPSHOT_COUNT=50000
ETCD_ENDPOINTS=etcd:2379
MINIO_ADDRESS=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
OPENSEARCH_INITIAL_ADMIN_PASSWORD=Admin@123
OPENSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
ENRIGIN_VISIBLE_DEVICES=0,1
LD_LIBRARY_PATH=/opt/rivs/lib

# ===== 多节点监控与日志 =====
RAG_NODE_ID=127.0.0.1
RAG_PEERS=http://rag:6000
LOKI_URL=http://loki:3100
