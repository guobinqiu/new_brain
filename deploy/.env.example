# ===== 构建镜像源（backend 镜像 build args）=====
USE_CN_MIRROR=false
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
UV_DEFAULT_INDEX_CN=https://pypi.tuna.tsinghua.edu.cn/simple

# ===== backend 运行 =====
# CPU 节点用 docker-cpu.yaml，GPU 节点用 docker-gpu.yaml
TZ=Asia/Shanghai
CONFIG_FILE=docker-cpu.yaml
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-search
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# rag 节点连接共享服务；把下面地址改成 svc 所在节点的 IP 或域名。
DATABASE_URL=postgresql://rag:rag@19.16.1.233:5432/rag
QDRANT_URL=http://19.16.1.233:6333
S3_ENDPOINT_URL=http://19.16.1.233:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rag

# ===== 内置基础服务 =====
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
VITE_API_TARGET=http://backend:6000
CHOKIDAR_USEPOLLING=true
ETCD_AUTO_COMPACTION_MODE=revision
ETCD_AUTO_COMPACTION_RETENTION=1000
ETCD_QUOTA_BACKEND_BYTES=4294967296
ETCD_SNAPSHOT_COUNT=50000
ETCD_ENDPOINTS=etcd:2379
MINIO_ADDRESS=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

# ===== 多节点监控与日志 =====
RAG_NODE_ID=node-233
RAG_PEERS=http://19.16.1.233:6000,http://19.16.1.90:6000
LOKI_URL=http://19.16.1.233:3100
